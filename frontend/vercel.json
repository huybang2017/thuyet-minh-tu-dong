{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://thuyet-minh-backend.onrender.com/api/:path*" },
    { "source": "/static/:path*", "destination": "https://thuyet-minh-backend.onrender.com/static/:path*" },
    { "source": "/((?!api/|static/|assets/).*)", "destination": "/index.html" }
  ]
}
