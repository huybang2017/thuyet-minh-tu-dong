@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam ActivityBorderThickness 1.5

|Người dùng (Chủ quán / Admin)|
start
:Chọn "Quên mật khẩu" và nhập địa chỉ Email;

|Hệ thống (Backend & DB)|
if (Hệ thống đã cấu hình SMTP?) then (Chưa)
  :Báo lỗi chức năng gửi thư chưa khả dụng;
  stop
else (Đã cấu hình)
  :Kiểm tra Email trong cơ sở dữ liệu;
  if (Email tồn tại?) then (Không)
    :Trả về thông báo chung (tránh lộ thông tin tài khoản);
    stop
  else (Có)
    :Tạo Reset Token (chỉ dùng 1 lần, có thời hạn);
    :Lưu Token gắn với tài khoản;
    |Dịch vụ Email (SMTP)|
    :Gửi email chứa đường dẫn/mã đặt lại mật khẩu;
  endif
endif

|Người dùng (Chủ quán / Admin)|
:Mở email, truy cập liên kết và nhập mật khẩu mới;

|Hệ thống (Backend & DB)|
:Kiểm tra tính hợp lệ của Token;

if (Token hợp lệ, chưa dùng & còn hạn?) then (Không)
  :Từ chối yêu cầu và báo lỗi Token hết hạn/không hợp lệ;
  |Người dùng (Chủ quán / Admin)|
  :Nhận thông báo lỗi (cần yêu cầu lại mã mới);
  stop
else (Có)
  |Hệ thống (Backend & DB)|
  :Băm (Hash) và cập nhật mật khẩu mới vào CSDL;
  :Vô hiệu hóa / Xóa Token ngay lập tức;
  |Người dùng (Chủ quán / Admin)|
  :Nhận thông báo thành công và đăng nhập lại;
  stop
endif
@enduml